{
  "version": 1,
  "contentWorld": "ArcInjections",
  "scripts": [
    {
      "id": "runtime",
      "file": "modules/runtime.js",
      "injectionTime": "documentStart",
      "mainFrameOnly": false,
      "matches": ["*"]
    },
    {
      "id": "page-metadata",
      "file": "modules/page-metadata.js",
      "injectionTime": "documentEnd",
      "mainFrameOnly": true,
      "matches": ["*"]
    },
    {
      "id": "dom-extractor",
      "file": "modules/dom-extractor.js",
      "injectionTime": "documentEnd",
      "mainFrameOnly": true,
      "matches": ["*"]
    },
    {
      "id": "selection-capture",
      "file": "modules/selection-capture.js",
      "injectionTime": "documentEnd",
      "mainFrameOnly": false,
      "matches": ["*"]
    },
    {
      "id": "youtube-transcript",
      "file": "modules/youtube-transcript.js",
      "injectionTime": "documentEnd",
      "mainFrameOnly": true,
      "matches": ["youtube.com", "*.youtube.com"]
    }
  ]
}
